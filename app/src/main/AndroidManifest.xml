<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rest timer only. No internet permission: Forkout works fully offline. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Countdown and "rest over" notice on the lock screen (asked at the first workout). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rest alarms to the second; timer apps get this automatically (Android 13+). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".ForkoutApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forkout">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Forkout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".timer.RestAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".timer.RestActionReceiver"
            android:exported="false" />
    </application>

</manifest>